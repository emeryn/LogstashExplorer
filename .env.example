# OPTIONAL — the stack starts without any .env file. Copy to .env only to override defaults.
# Never put secrets here: secrets are generated into volumes (local) or fetched from Vault (production).

# Public URL as seen by browsers (cookies, WebAuthn origin, OIDC redirect URI)
LSX_PUBLIC_URL=http://localhost:8080
LSX_WEBAUTHN_RP_ID=localhost
LSX_HTTP_PORT=8080
LSX_LOG_LEVEL=INFO

# OIDC / LDAPS are configured in Administration -> Directory & SSO. These variables only seed those
# settings on first boot (they never overwrite what an administrator saved).
# OIDC (authorization code + PKCE). Client secret: admin UI, or secret "oidc_client_secret".
# Redirect URI to register at the IdP: ${LSX_PUBLIC_URL}/api/auth/oidc/callback
LSX_OIDC_ISSUER=
LSX_OIDC_CLIENT_ID=

# LDAPS only (ldaps://). Bind password: admin UI, or secret "ldap_bind_password".
LSX_LDAP_URL=
LSX_LDAP_BIND_DN=
LSX_LDAP_USER_BASE=

# Concurrency: parallel Logstash runs per runner container, and per-user limit (runs + agent sessions)
RUNNER_CONCURRENCY=3
LSX_MAX_RUNS_PER_USER=2
